<% layout('layouts/admin') %>
<script>
  function show_name_on_lg_div(checked) {
    const name_on_lg_div = document.getElementById('name_on_lg_div');
    if (checked) {
      name_on_lg_div.classList.remove('hidden');
      document.getElementById('user_name_on_lg').select();
    } else {
      name_on_lg_div.classList.add('hidden');
    }
  }
</script>
<div>
  <fieldset class="boxed">
    <% if (errors && errors.length) { %>
      <ul class="error">
        <% errors.forEach((e) => { %>
          <li><%= e %></li>
        <% }); %>
      </ul>
    <% } %>
    <legend>Your User Profile</legend>
    <form action="/user/profile/<%= user.id %>" method="post">
      <div class="user-form-grid">
        <label for="user_name">Name:</label>
        <input id="user_name" class="boxed" type="text" name="name" value="<%= user.name %>" size="40">
        <label for="user_password">Password:</label>
        <input id="user_password" class="boxed" type="password" name="password" size="40">
        <label for="user_password_confirmation">Confirm:</label>
        <input id="user_password_confirmation" class="boxed" type="password" name="password_confirmation" size="40">
      </div>
      <hr>
      <label>
        <input type="checkbox" name="on_lg" <%= user.on_lg ? 'checked="checked"' : '' %> onchange="show_name_on_lg_div(this.checked);">
        &nbsp;Player on Little Golem?
      </label>
      <br>
      <div id="name_on_lg_div" class="p-5<%= user.on_lg ? '' : ' hidden' %>">
        <label for="user_name_on_lg">Name on Little Golem, if different from above:</label>
        <br>
        <input id="user_name_on_lg" class="boxed" type="text" name="name_on_lg" value="<%= user.name_on_lg || '' %>" size="40">
        <br>
      </div>
      Info:<br>
      <textarea class="boxed user-info" name="info"><%= user.info || '' %></textarea>
      <hr>
      <% if (params) { %>
      <input type="hidden" name="back_to" value="<%= params.back_to ?? '' %>">
      <% if (params.ret_gid) { %>
        <input type="hidden" name="ret_gid" value="<%= params.ret_gid %>">
      <% }
        if (params.player1) { %>
        <input type="hidden" name="player1" value="<%= params.player1 %>">
      <% }
        if (params.player2) { %>
        <input type="hidden" name="player2" value="<%= params.player2 %>">
      <% }
        if (params.size) { %>
        <input type="hidden" name="size" value="<%= params.size %>">
      <% }
        if (params.link_policy) { %>
        <input type="hidden" name="link_policy" value="<%= params.link_policy ?? '' %>">
      <% }
      }
      %>
      <input class="submit" type="submit" value="Change">
      &nbsp;<a href="/<%= params?.back_to === 'game' ? 'game/' + (params.ret_gid || '') : '' %><%= params && params.back_to === 'game' && params.ret_gid === 'blank' ? '?player1=' + (params.player1 || '') + '&player2=' + (params.player2 || '') + '&size=' + (params.size || '') + '&link_policy=' + (params.link_policy || '') + '&swap_style=' + (params.swap_style || '') : '' %>">Cancel</a>
    </form>
  </fieldset>
</div>
