<% layout('layouts/main_page') %>
<h2>Twixt Commentator</h2>
A forum to view, comment on, and read other people's comments on Twixt games.&nbsp;Enjoy!
<br/>
<br/>
<form action="/game" method="post">
  View <a href="http://littlegolem.net/">Little Golem</a> Twixt Game:&nbsp;<input id="new_gid" class="boxed" type="text" name="new_gid" size="12" maxlength="12">
  <input type="submit" value="Go">
</form>
<br/>
<button id="new-blank-board-btn" onclick="openBlankBoardModal(); return false;">New Blank Board</button>

<!-- Blank Board Modal -->
<div id="blank-board-overlay" class="blank-board-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="blank-board-title">
  <div class="blank-board-modal">
    <h3 id="blank-board-title">New Blank Board</h3>
    <form id="blank-board-form" onsubmit="submitBlankBoardForm(); return false;">
      <table class="blank-board-form-table">
        <tr>
          <td><label for="blank-player1">Player 1 (White):</label></td>
          <td><input id="blank-player1" class="boxed" type="text" name="player1" value="Player1" size="20" maxlength="40"></td>
        </tr>
        <tr>
          <td><label for="blank-player2">Player 2 (Black):</label></td>
          <td><input id="blank-player2" class="boxed" type="text" name="player2" value="Player2" size="20" maxlength="40"></td>
        </tr>
        <tr>
          <td><label for="blank-board-size">Board Size:</label></td>
          <td>
            <input id="blank-board-size" class="boxed" type="number" name="size" onfocus="this.select();" value="24" min="8" max="52" size="4">
            <span class="blank-board-hint">(8–52)</span>
          </td>
        </tr>
        <tr>
          <td><label for="blank-link-removal">Link Removal:</label></td>
          <td>
            <input id="blank-link-removal" type="checkbox" name="link_removal">
          </td>
        </tr>
      </table>
      <div class="blank-board-buttons">
        <input type="submit" value="OK">
        <input type="button" value="Cancel" onclick="closeBlankBoardModal();">
      </div>
      <input type="hidden" id="page" value="<%= params?.page || '' %>">
    </form>
  </div>
</div>

<script>
function openBlankBoardModal() {
  document.getElementById('blank-board-overlay').classList.remove('hidden');
  document.getElementById('blank-player1').focus();
}
function closeBlankBoardModal() {
  document.getElementById('blank-board-overlay').classList.add('hidden');
}
function submitBlankBoardForm() {
  const player1 = encodeURIComponent(document.getElementById('blank-player1').value || 'Player1');
  const player2 = encodeURIComponent(document.getElementById('blank-player2').value || 'Player2');
  let size = parseInt(document.getElementById('blank-board-size').value, 10);
  if (isNaN(size) || size < 8) size = 8;
  if (size > 52) size = 52;
  const linkPolicy = document.getElementById('blank-link-removal').checked ? 'R' : '';
  const page = document.getElementById('page').value;
  window.location.href = `/game/blank?player1=${player1}&player2=${player2}&size=${size}&link_policy=${linkPolicy}&main_page=${page}`;
}
document.getElementById('blank-board-overlay').addEventListener('click', function(e) {
  if (e.target === this) closeBlankBoardModal();
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeBlankBoardModal();
});
</script>
<h3>Commented Games</h3>
<table class="main" cellspacing="0">
  <thead>
    <tr>
      <th class="main">Game #</th>
      <th class="main">Size</th>
      <th class="main">Winner</th>
      <th class="main">Loser</th>
      <th class="main">End</th>
      <th class="main">Tournament</th>
      <th class="main">Last Comment</th>
      <th class="main">Author</th>
    </tr>
  </thead>
  <tbody>
    <% commentedGames.forEach((game, i) => { %>
      <tr class="<%= i % 2 === 0 ? 'even' : 'odd' %>">
        <td class="main text-right">
          <% if (game.lg_game_num == null) { %>
            <a href="/game/blank/<%= game.id %>?main_page=<%= params?.page || '' %>">blank/<%= game.id %></a>
          <% } else { %>
            <a href="/game/<%= game.lg_game_num %>?main_page=<%= params?.page || '' %>"><%= game.lg_game_num %></a>
          <% } %>
        </td>
        <td class="main text-center">
          <%= game.board_size || '' %>
        </td>
        <% if (game.lg_game_num == null) { %>
        <td class="main"><%- h2(game.player1) %></td>
        <td class="main"><%- h2(game.player2) %></td>
        <td class="main text-center"></td>
        <% } else { %>
        <td class="main<%= game.isDraw() ? ' italic' : '' %>">
          <%- h2(game.winnerName()) %>
        </td>
        <td class="main<%= game.isDraw() ? ' italic' : '' %>">
          <%- h2(game.loserName()) %>
        </td>
        <td class="main text-center<%= game.isResignation() ? '' : ' bold' %>">
          <%= game.result %>
        </td>
        <% } %>
        <td class="main">
          <% if (game.tournament && game.tournament.trim() !== '') { %>
            <%= game.tournament %>
          <% } else { %>
            &nbsp;
          <% } %>
        </td>
        <td class="main text-center">
          <%= game.last_commented_on ? new Date(game.last_commented_on).toISOString().slice(0,16).replace('T',' ') : '' %>
        </td>
        <% const author = authorMap[game.last_commented_by]; %>
        <td class="main">
          <% if (author) { %>
            <%- h2(author.name) %>&nbsp;<a href="/user/info/<%= author.id %>"><img class="info" src="/images/info.gif" alt="(info)" width="9" height="9"></a>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>
Page:&nbsp;<% pages.forEach((p) => { %>
  <% if (p.page === null) { %>
    ...&nbsp;
  <% } else if (p.current) { %>
    <%= p.label %>&nbsp;
  <% } else { %>
    <a href="<%= p.url %>"><%= p.label %></a>&nbsp;
  <% } %>
<% }); %>
<br/>
<br/>
<p>
  <a href="/faq">FAQ</a>&nbsp;|&nbsp;<a href="/rss_feed/all_comments.rss">RSS</a>
</p>
