<% layout('layouts/game') %>

<div class="game-header">
  <div class="game-number-form">
    <form action="/game" method="post">
      Game number:&nbsp;<input class="boxed" type="text" name="new_gid" value="<%= params?.gid ?? '' %>" size="12" maxlength="12">
      <input type="submit" value="Go">
      &nbsp;<a href="/">Main Page</a>
    </form>
  </div>
  <% if (game) { %>
  <div class="game-players">
    <img id="player1-label" alt="Player 1:">
    <span class="<%= game.isBlank ? '' : (game.winner === 1 ? 'winner' : 'loser') %>"><%- h2(game.player1) %></span>
    &nbsp;&nbsp;
    <img id="player2-label" alt="Player 2:">
    <span class="<%= game.isBlank ? '' : (game.winner === 2 ? 'winner' : 'loser') %>"><%- h2(game.player2) %></span>
  </div>

  <div id="turn" class="turn"></div>
  <% } %>
</div>

<% if (game) { %>
<div class="game-details">
  <div class="board-side">
  <div id="board" class="board">
    <div id="boardglass1" class="boardglass"></div>
    <div id="boardglass2" class="boardglass hidden"></div>
    <div id="markerglass" class="markerglass">
      <img id="crosshair" class="crosshair hidden" src="/images/pieces/crosshair.gif" galleryimg="no" alt="">
      <img id="newwhitepeg" class="new-peg hidden" src="/images/pieces/newwhitepeg.gif" galleryimg="no" alt="">
      <img id="newblackpeg" class="new-peg hidden" src="/images/pieces/newblackpeg.gif" galleryimg="no" alt="">
    </div>
    <div id="topglass" class="topglass">
      <a id="swap-button" class="swap-button hidden">swap</a>
    </div>

    <%# CSS-rendered game board %>
    <div id="twixt-board" class="twixt-board" aria-hidden="true">
      <div class="border"></div>
      <div class="crucial-diagonals">
        <%# Eight crucial diagonal reference lines drawn as an inline SVG.
            Coordinates are in SVG units 0-100; the SVG is scaled to fill
            the square playing area via preserveAspectRatio="none". %>
        <svg class="diagonal-lines" xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 100 100" preserveAspectRatio="none"
             aria-hidden="true">
          <line x1="0"   y1="0"   x2="100" y2="50"  stroke-width="1" vector-effect="non-scaling-stroke"/>
          <line x1="0"   y1="0"   x2="50"  y2="100" stroke-width="1" vector-effect="non-scaling-stroke"/>
          <line x1="100" y1="0"   x2="50"  y2="100" stroke-width="1" vector-effect="non-scaling-stroke"/>
          <line x1="100" y1="0"   x2="0"   y2="50"  stroke-width="1" vector-effect="non-scaling-stroke"/>
          <line x1="0"   y1="50"  x2="100" y2="100" stroke-width="1" vector-effect="non-scaling-stroke"/>
          <line x1="100" y1="50"  x2="0"   y2="100" stroke-width="1" vector-effect="non-scaling-stroke"/>
          <line x1="0"   y1="100" x2="50"  y2="0"   stroke-width="1" vector-effect="non-scaling-stroke"/>
          <line x1="100" y1="100" x2="50"  y2="0"   stroke-width="1" vector-effect="non-scaling-stroke"/>
        </svg>
      </div>
      <div class="holes-layer">
        <div class="upper left corner"></div>
        <div class="upper right corner"></div>
        <div class="lower left corner"></div>
        <div class="lower right corner"></div>
      </div>
      <div class="row-numbers left-side">
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
      </div>
      <div class="row-numbers right-side">
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
      </div>
      <div class="column-letters top-side">
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div>
      </div>
      <div class="column-letters2 top-side right-half">
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div>
      </div>
      <div class="column-letters bottom-side">
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div>
      </div>
      <div class="column-letters2 bottom-side right-half">
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div><div></div><div></div>
        <div></div><div></div>
      </div>
    </div>
  </div>

  <div id="underbar">
    <% if (game.isBlank) {
    if (game.link_policy === 'R') { %>
      <span class='underbar-status'>Link Removal is <b>ON</b></span><%= (game.swap_style === 'P')? ',': '' %>
    <% }
    if (game.swap_style === 'P') { %>
      <span class='underbar-status'>Swap style is <b>Swap Player Colors</b></span>
      <% }
    } else {
      if (game.tournament && game.tournament.trim() !== '' && game.tournament.trim() !== 'twixt') { %>
      <a href="http://www.littlegolem.net/jsp/tournament/tournament.jsp?trnid=<%= game.tournament %>"><%- game.tournament + '&nbsp;(LG)' %></a> |
    <% } %>
    <a href="http://www.littlegolem.net/jsp/game/game.jsp?gid=<%= game.lg_game_num %>">This&nbsp;game&nbsp;(LG)</a> |
    <a href="/jtwixt/gen?gameid=<%= params?.gid %>">Download&nbsp;JTwixt&nbsp;file</a>
    <% } %>
  </div>
  </div>

  <div id="sidebar" class="sidebar">
    <div id="moves-panel" class="moves-panel">
      <div id="moves"></div>
      <div>
        <span id="copyMovesBtn" class="copy-moves-btn hidden" onclick="copyMovesToClipboard()" title="Copy variation moves to clipboard">⧉</span>
        <span id="user-moves"></span>
      </div>
      <div class="back-next">
        <a id="backLink" href="" accesskey="b" onclick="backButton(); return false;">Back</a>
        <a id="nextLink" href="" accesskey="n" onclick="nextButton(); return false;">Next</a>
      </div>
    </div>

    <div id="comments">
      <div id="current-comments">
        <% const namedSequences = {}; %>
        <% (game.comments || []).forEach((comment) => { %>
          <div class="comment-header">
            <%- include('../comment/_comment_header', { comment: comment, author: comment.author, preview: false }) %>
          </div>
          <%- prepareComment(comment.comment, game.swap_style, namedSequences) %>
          <br>
          <br>
        <% }); %>
      </div>
      <% if (game.isInProgress()) { %>
        <div class="comment-header">Game is in progress.</div>
      <% } else if (!session || !session.user_id) { %>
        <div class="comment-header">You must be logged in to add comments.</div>
      <% } else { %>
        <div id="addCommentLink">
          <a href="" onclick="return showAddCommentBox();">Add a comment</a>
          <span id="undoDiscardLink" class="hidden"> | <a href="" onclick="return undoDiscard();">Restore draft</a></span>
        </div>
        <div id="addComment" class="hidden">
          <div class="comment-header">Add a comment:</div>
          <form id="comment_form" action="/comment" method="post">
            <input type="hidden" name="game" value="<%= game.id || 'blank' %>">
            <input type="hidden" id="button_pressed" name="button_pressed" value="Comment">
            <% if (game.isBlank) { %>
            <input type="hidden" name="player1" value="<%= game.player1 %>">
            <input type="hidden" name="player2" value="<%= game.player2 %>">
            <input type="hidden" name="board_size" value="<%= game.board_size %>">
            <input type="hidden" name="link_policy" value="<%= game.link_policy || '' %>">
            <input type="hidden" name="swap_style" value="<%= game.swap_style || '' %>">
            <% } %>
            <textarea class="comment-textarea" id="new_comment" name="new_comment" rows="8" onkeyup="checkStateChange(); scheduleSave();" onfocus="commentsInFocus(true)" onblur="commentsInFocus(false)"></textarea>
            <div class="comment-buttons">
              <input id="comment_button" type="submit" value="Comment" onclick="removePreview(); setButtonPressed(this, 'Comment'); return hideAddCommentBox();" disabled>
              <input id="preview_button" type="submit" value="Preview" onclick="removePreview(); setButtonPressed(this, 'Preview'); return true;" disabled>
              <input type="button" class="discard" value="Discard" onclick="return hideAddCommentBox();">
            </div>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>
  <% if (parser) { %>
    <input type="hidden" id="movesJson" name="movesJson" value="<%= JSON.stringify(parser.getMovesList()) %>">
    <input type="hidden" id="boardSize" name="boardSize" value="<%= parser.getBoardSize() %>">
    <input type="hidden" id="linkPolicy" name="linkPolicy" value="<%= game.link_policy || '' %>">
    <input type="hidden" id="swapStyle" name="swapStyle" value="<%= game.swap_style || '' %>">
  <% } %>
<% } %>

<noscript>
  <div class="noscript">JavaScript was not detected. This site requires JavaScript to be enabled in your browser.</div>
</noscript>

<% block('scripts', include('_comment_script')); %>
