<script>
(() => {
  const form = document.getElementById('comment_form');
  if (!form) return;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const buttonPressed = document.getElementById('button_pressed').value;
    const data = new FormData(form);
    const body = new URLSearchParams();
    data.forEach((v, k) => body.append(k, v));

    fetch('/comment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString()
    })
    .then(r => r.text())
    .then((html) => {
      const container = document.getElementById('current_comments');
      if (container && html.trim()) {
        container.insertAdjacentHTML('beforeend', html);
      }
      // After a real Comment submission (not Preview), reset the UI
      if (buttonPressed !== 'Preview') {
        document.getElementById('new_comment').value = '';
        checkStateChange();
        document.getElementById('addComment').style.display = 'none';
        document.getElementById('addCommentLink').style.display = 'inline';
      }
    })
    .catch((err) => console.error('Comment submit error:', err));
  });
})();
</script>

