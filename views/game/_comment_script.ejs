<script>
(() => {
  const form = document.getElementById('comment_form');
  if (!form) return;

  // Show "Restore draft" link on page load if there's a saved discard
  updateUndoLink();

  // Save draft if the comment box is open when the page is unloaded
  window.addEventListener('beforeunload', () => {
    const addComment = document.getElementById('addComment');
    if (addComment && !addComment.classList.contains('hidden')) {
      const text = document.getElementById('new_comment').value;
      if (text.trim()) {
        sessionStorage.setItem('discard_' + location.pathname, text);
      }
    }
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const buttonPressed = document.getElementById('button_pressed').value;
    const data = new FormData(form);
    const body = new URLSearchParams();
    data.forEach((v, k) => body.append(k, v));

    fetch('/comment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString()
    })
    .then(r => {
      // Capture the new game id (returned on first blank-board comment) before consuming body
      const newGameId = r.headers.get('X-New-Game-Id');
      return r.text().then(html => ({ html, newGameId }));
    })
    .then(({ html, newGameId }) => {
      const container = document.getElementById('current-comments');
      if (container && html.trim()) {
        removePreview();
        container.insertAdjacentHTML('beforeend', html);
      }
      if (buttonPressed !== 'Preview') {
        // If this was the first comment on an unsaved blank board, update state
        if (newGameId) {
          form.elements['game'].value = newGameId;
          // Remove the one-shot player/board_size fields — no longer needed
          ['player1', 'player2', 'board_size', 'link_policy', 'swap_style'].forEach(name => {
            const el = form.elements[name];
            if (el) el.parentNode.removeChild(el);
          });
          // Update the browser URL to the saved-game URL without reloading
          history.pushState(null, '', `/game/blank/${newGameId}`);
        }
        document.getElementById('new_comment').value = '';
        sessionStorage.removeItem('discard_' + location.pathname);
        checkStateChange();
        updateUndoLink();
        document.getElementById('addComment').classList.add('hidden');
        document.getElementById('addCommentLink').classList.remove('hidden');
      }
    })
    .catch((err) => console.error('Comment submit error:', err));
  });
})();
</script>

