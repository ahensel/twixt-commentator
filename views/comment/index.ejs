<% if (comment) { %>
  <% if (preview) { %>
    <div id="preview">
      <div class="preview-header">
        <%- include('_comment_header', { comment: comment, author: author.dataValues, preview: true }) %>
      </div>
      <%- prepareComment(comment.comment) %>
      <br/>
      <br/>
    </div>
  <% } else { %>
    <div class="comment-header">
      <%- include('_comment_header', { comment: comment, author: author.dataValues, preview: false }) %>
    </div>
    <%- prepareComment(comment.comment) %>
    <br/>
    <br/>
  <% } %>
  <script>
    scrollToBottom();
  </script>
<% } %>
