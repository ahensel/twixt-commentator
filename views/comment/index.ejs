<% if (comment) { %>
  <% if (preview) { %>
    <div id="preview">
      <div class="preview-header">
        <%- include('_comment_header', { comment: comment, author: author.dataValues, preview: true }) %>
      </div>
      <div id="preview-body" class="comment" data-raw-comment="<%= comment.comment %>"></div>
    </div>
  <% } else { %>
    <div id="comment-header-<%= comment.id %>" class="comment-header">
      <%- include('_comment_header', { comment: comment, author: author.dataValues, preview: false }) %>
    </div>
    <div id="comment-body-<%= comment.id %>" class="comment" data-raw-comment="<%= comment.comment %>">
    </div>
  <% } %>
  <script>
    scrollToBottom();
  </script>
<% } %>
