<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title><% if (!game) { %>Twixt Commentator<% } else { %><%= h2(game.player1) %> | <%= h2(game.player2) %><% } %></title>
    <link rel="stylesheet" href="/stylesheets/twixt.css" media="all">
    <script src="/javascripts/peg.js"></script>
    <script src="/javascripts/link.js"></script>
    <script src="/javascripts/move.js"></script>
    <script src="/javascripts/twixtboard.js"></script>
    <script src="/javascripts/twixtcontroller.js"></script>
    <script src="/javascripts/twixtmoves.js"></script>
    <script src="/javascripts/view.js"></script>
    <script src="/javascripts/comments.js"></script>
    <script src="/javascripts/user_info_modal.js"></script>
    <link href="/favicon.ico" rel="icon" type="image/x-icon">
  </head>
  <body class="game-page">
    <p class="err"><%= flash && flash.error ? flash.error : '' %></p>
    <%- include('_loginbox') %>
    <%- body %>
    <%- block('scripts') %>
  </body>
</html>
