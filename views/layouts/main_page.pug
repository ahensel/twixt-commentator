doctype html
html
  head
    meta(http-equiv='Content-Type' content='text/html; charset=utf-8')
    title Twixt Commentator
    link(rel='stylesheet' href='/stylesheets/twixt.css' media='all')

    link(href='/favicon.ico' rel='icon' type='image/x-icon')
    link(href='/favicon.ico' rel='shortcut icon' type='image/x-icon')
    link(rel='alternate' type='application/rss+xml' title='Twixt Commentator RSS' href='/rss_feed/all_comments.rss')
    script.
      window.addEventListener('load', () => {
        const f = document.getElementById('new_gid');
        if (f) f.focus();
      });
  body.main_page
    p.err= flash && flash.error ? flash.error : ''
    include _loginbox
    block content
