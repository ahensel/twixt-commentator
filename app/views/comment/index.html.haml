- if @comment
  #preview
    -if @preview
      .previewHeader
        =render :partial => 'comment_header', :locals => {:comment => @comment}
    -else
      .commentHeader
        =render :partial => 'comment_header', :locals => {:comment => @comment}
      
    = xssize @comment.comment
    %br
    %br
  :javascript
    scrollToBottom();
