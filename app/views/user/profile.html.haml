%div
  %fieldset.boxed
    = error_messages_for 'user'
    %legend
      Your User Profile
    - form_for :user do |form|
      %table
        %tr
          %td
            %label{ :for => "user_name" }
              Name:
          %td
            = form.text_field :name, :size => 40, :class => 'boxed'
        %tr
          %td
            %label{ :for => "user_password" }
              Password:
          %td
            = form.password_field :password, :size => 40, :class =>'boxed'
        %tr
          %td
            %label{ :for => "user_password_confirmation" }
              Confirm:
          %td
            = form.password_field :password_confirmation, :size => 40, :class => 'boxed'
      %hr
      / checkbox: player on lg? if so, show following
      %label
        = form.check_box :on_lg, :onchange => "$('name_on_lg_div').style.display = (this.checked? 'block' : 'none'); return true;"
        \&nbsp;Player on Little Golem?
      %br
      / name on LG, if different from name
      #name_on_lg_div{ :style => "padding: 5px; display: <haml:silent> if @user.on_lg then </haml:silent>block<haml:silent> else </haml:silent>none<haml:silent> end </haml:silent>;" }
        %label{ :for => "user_name_on_lg" }
          Name on Little Golem, if different from above:
        %br
        = form.text_field :name_on_lg, :size => 40, :class => 'boxed'
        %br
      / info
      Info:
      %br
      = form.text_area :info, :class => 'boxed'
      %hr
      = hidden_field_tag 'back_to', params[:back_to]
      - if !!params[:main_page]
        = hidden_field_tag 'main_page', params[:main_page]
      - if !!params[:ret_gid] then
        = hidden_field_tag 'ret_gid', params[:ret_gid]
      = submit_tag 'Change', :class => 'submit'
      = link_to 'Cancel', :controller => params[:back_to], :gid => params[:ret_gid], :page => params[:main_page]
