
<div>
<fieldset class='boxed'>
  <%= error_messages_for 'user' %>
  
  <legend>New User Registration for Twixt Game Reviewer</legend>
  
  <% form_for :user do |form| %>
    <table>
      <tr><td>
        <label for='user_name'>Name:</label>
      </td><td>
        <%= form.text_field :name, :size => 40, :class => 'boxed' %>
        <span style='color: #ff0000'>&nbsp;(Required)</span>
      </td></tr>
      <tr><td>
        <label for='user_password'>Password:</label>
      </td><td>
        <%= form.password_field :password, :size => 40, :class =>'boxed' %>
        <span style='color: #ff0000'>&nbsp;(Required)</span>
      </td></tr>    
      <tr><td>
        <label for='user_password_confirmation'>Confirm:</label>
      </td><td>
        <%= form.password_field :password_confirmation, :size => 40, :class => 'boxed' %>
        <span style='color: #ff0000'>&nbsp;(Required)</span>
      </td></tr>
    </table>
    <hr>
    <!-- checkbox: player on lg? if so, show following -->
    <label><%= form.check_box :on_lg, :onchange => "$('name_on_lg_div').style.display = (this.checked? 'block' : 'none'); return true;" %>&nbsp;Player on Little Golem?</label><br/>
    <!-- name on LG, if different from name -->
    <div id='name_on_lg_div' style='padding: 5px; display: none;'>
      <label for='user_name_on_lg'>Name on Little Golem, if different from above:</label><br/>
      <%= form.text_field :name_on_lg, :size => 40, :class => 'boxed' %><br/>
    </div>
    <!-- info -->
    Info:<br/>
    <%= form.text_area :info, :class => 'boxed' %>
    <hr>
    <%= hidden_field_tag 'back_to', params[:back_to] %>
    <% if !!params[:main_page] %><%= hidden_field_tag 'main_page', params[:main_page] %><% end -%>
    <% if !!params[:ret_gid] then %><%= hidden_field_tag 'ret_gid', params[:ret_gid] %><% end -%>
    <%= submit_tag 'Register', :class => 'submit' %>
    <%= link_to 'Cancel', :controller => params[:back_to], :gid => params[:ret_gid], :page => params[:main_page] %>
  <% end %>
</fieldset>
</div>