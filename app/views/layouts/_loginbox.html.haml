- if !session[:user_id]
  .loginBox
    - form_tag :controller => :user, :action => :login, :ret_gid => params[:gid], :back_to => params[:controller], :main_page => params[:page] do
      %table
        %tr
          %td
            .boxed
              %table
                %tr
                  %td
                    %label{ :for => "name" }
                      Name:
                  %td
                    = text_field_tag :name, params[:name], :class => 'boxed'
                  %td
                %tr
                  %td
                    %label{ :for => "password" }
                      Password:
                  %td
                    = password_field_tag :password, params[:password], :class => 'boxed'
                  %td
                    = submit_tag 'Log in'
              - if !!flash[:login_notice]
                \&nbsp;
                %span.err
                  = flash[:login_notice]
          %td
            .pleaseRegister
              = link_to 'Register', {:controller => :user, :action => :add_user, :back_to => params[:controller], :ret_gid => params[:gid], :main_page => params[:page]}
              %br
              to add
              %br
              comments.
- else
  .loginBox
    - current_user = User.find_by_id(session[:user_id])
    Welcome,
    %b
      = h2 current_user.name
    = link_to image_tag('/images/info.gif', :class => 'info', :alt => '(info)', :width => '9', :height => '9'), :controller => 'user', :action => 'info', :id => current_user.id, :back_to => params[:controller], :ret_gid => params[:gid], :main_page => params[:page]
    %br
    = link_to 'Profile', :controller => :user, :action => :profile, :id => session[:user_id], :ret_gid => params[:gid], :back_to => params[:controller], :main_page => params[:page]
    |
    = link_to 'Log out', :controller => :user, :action => :logout, :ret_gid => params[:gid],  :back_to => params[:controller], :main_page => params[:page]
