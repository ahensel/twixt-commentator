%h2
  Twixt Commentator
A forum to view, comment on, and read other people's comments on finished Twixt games from
<a href="http://littlegolem.net/">Little Golem</a>.
Enjoy!
%p
  - form_tag :controller => 'game', :action => 'index' do
    View Little Golem Twixt Game:
    = text_field_tag :new_gid, '', :size => 7, :maxlength => 7, :class => 'boxed'
    = submit_tag 'Go'
  %h3
    Commented Games
  %table.main{ :cellspacing => "0" }
    %thead
      %tr
        %th.main
          Game #
        %th.main
          Winner
        %th.main
          Loser
        %th.main
          End
        %th.main
          Tournament
        %th.main
          Last Comment
        %th.main
          Author
    %tbody
      - for game in @commented_games
        %tr{ :class => cycle('even', 'odd') }
          %td.main
            = link_to game.lg_game_num, :controller => 'game', :gid => game.lg_game_num, :main_page => params[:page]
          <td class='main'
          - if game.is_draw
            style='font-style: italic;'
          >
          = h2 game.winner_name
          <td class='main'
          - if game.is_draw
            style='font-style: italic;'
          >
          = h2 game.loser_name
          %td.main{ :style => "text-align: center;<haml:silent> if !game.is_resignation then </haml:silent> font-weight: bold;<haml:silent> end </haml:silent>" }
            = game.result
          %td.main
            = (game.tournament.blank?)? '&nbsp;': game.tournament
          %td.main{ :style => "text-align: center;" }
            = game.last_commented_on.strftime('%Y-%m-%d %H:%M')
          - author = User.find_by_id(game.last_commented_by)
          %td.main
            = h2 author.name
            = link_to image_tag('/images/info.gif', :class => 'info', :alt => '(info)', :width => '9', :height => '9'), :controller => 'user', :action => 'info', :id => author.id, :back_to => params[:controller], :main_page => params[:page]
  Page:
  = pagination_links
